# Public domain pointing to this Ubuntu VPS
DOMAIN=bans.example.com

# PostgreSQL, kept inside Docker
POSTGRES_DB=vintage_shield
POSTGRES_USER=vintage_shield
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Shared private API secret
BOT_API_KEY=replace-with-a-different-long-random-secret

# Discord application
DISCORD_TOKEN=replace-with-the-discord-bot-token
ADMIN_GUILD_ID=123456789012345678
LOG_LEVEL=INFO
